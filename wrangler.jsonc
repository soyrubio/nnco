{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nnco",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-08-13",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS"
  },
  "vars": {
    "NODE_ENV": "production",
    "PUBLIC_APP_URL": "https://nnco.ai",
    "LEAD_HANDOFF_MODE": "supabase",
    "DISCOVERY_RATE_LIMIT_MODE": "supabase",
    "OPENAI_DISCOVERY_MODEL": "gpt-5.6-luna",
    "OPENAI_TRANSCRIPTION_MODEL": "gpt-transcribe",
    "OPENAI_API_BASE_URL": "https://api.openai.com"
  },
  "observability": {
    "enabled": true
  },
  "env": {
    "stage": {
      "name": "nnco-stage",
      "main": "./src/server/stage-worker.js",
      "assets": {
        "binding": "ASSETS",
        "run_worker_first": true
      },
      "vars": {
        "NODE_ENV": "production",
        "PUBLIC_APP_URL": "https://stage.nnco.ai",
        "BASIC_AUTH_USER": "stage",
        "LEAD_HANDOFF_MODE": "supabase",
        "DISCOVERY_RATE_LIMIT_MODE": "supabase",
        "OPENAI_DISCOVERY_MODEL": "gpt-5.6-luna",
        "OPENAI_TRANSCRIPTION_MODEL": "gpt-transcribe",
        "OPENAI_API_BASE_URL": "https://api.openai.com"
      }
    }
  }
}
