{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nnco",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-08-13",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS"
  },
  "vars": {
    "NODE_ENV": "production"
  },
  "observability": {
    "enabled": true
  },
  "env": {
    "stage": {
      "name": "nnco-stage",
      "main": "./src/server/stage-worker.js",
      "assets": {
        "binding": "ASSETS",
        "run_worker_first": true
      },
      "vars": {
        "NODE_ENV": "production"
      }
    }
  }
}
