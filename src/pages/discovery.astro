---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { DiscoveryLauncher } from "@/components/DiscoveryLauncher";
import Header from "@/components/Header.astro";
import ModularGlyph from "@/components/ModularGlyph.astro";
import { discoveryIntro } from "@/data/discovery";
import { discoveryIntroGlyph } from "@/data/glyphs";
import "@/styles/discovery.css";

export const prerender = false;
---

<BaseLayout
  title={`${discoveryIntro.brand} ${discoveryIntro.title}`}
  description={discoveryIntro.introduction}
  canonicalPath="/discovery"
  themeColor="#111111"
>
  <Header variant="discovery" />
  <DiscoveryLauncher client:load>
    <ModularGlyph {...discoveryIntroGlyph} />
  </DiscoveryLauncher>
</BaseLayout>
