---
import BaseLayout from "@/layouts/BaseLayout.astro";
import BlockArrow from "@/components/BlockArrow.astro";
import Button from "@/components/Button.astro";
import ClosingSection from "@/components/ClosingSection.astro";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import PageHero from "@/components/PageHero.astro";
import SectionFrame from "@/components/SectionFrame.astro";
import SectionRow from "@/components/SectionRow.astro";
import { getPost, posts, type Post } from "@/data/posts";

export const prerender = true;

export function getStaticPaths() {
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

interface Props {
  post: Post;
}

const { post } = Astro.props;
const related = post.relatedSlug ? getPost(post.relatedSlug) : undefined;
const canonical = `https://nnco.ai/blog/${post.slug}`;
const blogSchema = {
  "@type": "BlogPosting",
  headline: post.title,
  description: post.summary,
  datePublished: post.publishedAt,
  dateModified: post.updatedAt,
  author: { "@type": "Person", name: post.author, url: "https://nnco.ai/company" },
  publisher: { "@id": "https://nnco.ai/#organization" },
  mainEntityOfPage: canonical,
  inLanguage: "en",
};
const breadcrumbSchema = {
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://nnco.ai/" },
    { "@type": "ListItem", position: 2, name: "Blog", item: "https://nnco.ai/blog" },
    { "@type": "ListItem", position: 3, name: post.title, item: canonical },
  ],
};
---

<BaseLayout
  title={`${post.title} | NNCO`}
  description={post.summary}
  canonicalPath={`/blog/${post.slug}`}
  schemas={[blogSchema, breadcrumbSchema]}
>
  <Header />
  <main class="news-article editorial-page">
    <PageHero title={post.title} introduction={post.summary} />

    <SectionFrame class="news-article__body" labelledBy="article-introduction">
      <article class="news-article__sections">
        <span class="news-article__rule" aria-hidden="true"></span>

        <section class="news-article__section" aria-labelledby="article-introduction">
          <SectionRow title="Introduction" titleId="article-introduction">
            <div slot="heading-meta" class="news-article__byline">
              <time datetime={post.publishedAt}>{post.publishedLabel}</time>
              <span>{post.author}</span>
            </div>
          <div class="news-reading-copy">
            {post.introduction.map((paragraph) => <p>{paragraph}</p>)}
          </div>
          </SectionRow>
        </section>

        {
          post.sections.map((section, sectionIndex) => (
            <section
              class="news-article__section"
              aria-labelledby={`article-section-${sectionIndex + 1}`}
            >
              <SectionRow
                title={section.heading}
                titleId={`article-section-${sectionIndex + 1}`}
              >
                <div class="news-reading-copy">
                  {section.paragraphs.map((paragraph, paragraphIndex) => {
                    const link = section.links?.find(
                      (item) => item.paragraph === paragraphIndex,
                    );
                    if (!link || !paragraph.includes(link.text)) {
                      return <p>{paragraph}</p>;
                    }
                    const [before, after] = paragraph.split(link.text);
                    return <p>{before}<a href={link.href}>{link.text}</a>{after}</p>;
                  })}
                </div>
              </SectionRow>
            </section>
          ))
        }

        <section class="news-article__section" aria-labelledby="article-takeaway">
          <SectionRow title="The point to retain" titleId="article-takeaway">
            <div class="news-reading-copy">
              <blockquote><p>{post.keyStatement}</p></blockquote>
            </div>
          </SectionRow>
        </section>

        {
          related && (
            <aside class="news-article__section" aria-labelledby="related-title">
              <SectionRow title="Related perspective" titleId="related-title">
                <div class="news-article__related-content">
                  <h3>{related.title}</h3>
                  <p>{related.summary}</p>
                  <Button href={`/blog/${related.slug}`} variant="secondary">
                    Read next <BlockArrow />
                  </Button>
                </div>
              </SectionRow>
            </aside>
          )
        }
      </article>
    </SectionFrame>

    <ClosingSection
      id="blog-closing"
      tone="surface"
      description="If something here matches a problem you are working on, the fastest way to go further is 30 minutes with the people who wrote it."
      actions={[{ href: "/contact", label: "Book a 30-minute call" }]}
    />
  </main>
  <Footer />
</BaseLayout>
