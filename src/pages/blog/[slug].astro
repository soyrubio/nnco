---
import { render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import ArticleProse from "@/components/ArticleProse.astro";
import BlockArrow from "@/components/BlockArrow.astro";
import Button from "@/components/Button.astro";
import ClosingSection from "@/components/ClosingSection.astro";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import PageHero from "@/components/PageHero.astro";
import SectionFrame from "@/components/SectionFrame.astro";
import { getBlogEntries, type BlogEntry } from "@/lib/blog";
import { formatBlogDate } from "@/lib/blog-date";

export const prerender = true;

export async function getStaticPaths() {
  return (await getBlogEntries()).map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: BlogEntry;
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
if (headings.some((heading) => heading.depth === 1)) {
  throw new Error(
    `Blog post "${post.id}" must define its title in frontmatter and omit Markdown h1 headings.`,
  );
}
const publishedLabel = formatBlogDate(post.data.publishedAt);
const canonical = `https://nnco.ai/blog/${post.id}`;
const blogSchema = {
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.summary,
  datePublished: post.data.publishedAt,
  dateModified: post.data.updatedAt,
  author: {
    "@type": "Person",
    name: post.data.author,
    url: "https://nnco.ai/company",
  },
  publisher: { "@id": "https://nnco.ai/#organization" },
  mainEntityOfPage: canonical,
  inLanguage: "en",
};
const breadcrumbSchema = {
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://nnco.ai/" },
    { "@type": "ListItem", position: 2, name: "Blog", item: "https://nnco.ai/blog" },
    {
      "@type": "ListItem",
      position: 3,
      name: post.data.title,
      item: canonical,
    },
  ],
};
---

<BaseLayout
  title={`${post.data.title} | NNCo.`}
  description={post.data.summary}
  canonicalPath={`/blog/${post.id}`}
  schemas={[blogSchema, breadcrumbSchema]}
  ogType="article"
  articlePublishedTime={post.data.publishedAt}
  articleModifiedTime={post.data.updatedAt}
>
  <Header />
  <main class="news-article editorial-page">
    <PageHero title={post.data.title} titleId="article-title" />

    <SectionFrame class="news-article__body">
      <article class="news-article__layout">
        <header class="news-article__meta" aria-label="Publication details">
          <time datetime={post.data.publishedAt}>{publishedLabel}</time>
          <span>{post.data.author}</span>
          <Button href="/blog" variant="secondary">
            <BlockArrow direction="left" /> All posts
          </Button>
        </header>

        <div class="news-article__content">
          <ArticleProse>
            <Content />
          </ArticleProse>
        </div>
      </article>
    </SectionFrame>

    <ClosingSection
      id="blog-closing"
      description="If something here matches a problem you are working on, the fastest way to go further is 30 minutes with the people who wrote it."
      actions={[{ href: "/contact", label: "Book a 30-minute call" }]}
    />
  </main>
  <Footer />
</BaseLayout>
