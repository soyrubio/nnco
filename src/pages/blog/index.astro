---
import BaseLayout from "@/layouts/BaseLayout.astro";
import BlogPostList from "@/components/BlogPostList.astro";
import ClosingSection from "@/components/ClosingSection.astro";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import PageHero from "@/components/PageHero.astro";
import SectionAnatomy from "@/components/SectionAnatomy.astro";
import SectionFrame from "@/components/SectionFrame.astro";
import { posts } from "@/data/posts";

export const prerender = true;

---

<BaseLayout
  title="Blog: putting AI into production | NNCO"
  description="How AI systems actually reach production inside large institutions. Field notes, system explanations and working principles from the people building them."
  canonicalPath="/blog"
>
  <Header currentPath="/blog" />
  <main class="news-index editorial-page">
    <PageHero
      title="Blog"
      introduction="How AI systems reach production inside institutions that cannot afford to get it wrong. Written by the people doing the work, without client names and without numbers we cannot stand behind."
    />

    <SectionFrame labelledBy="featured-blog-title" class="news-feed">
      <SectionAnatomy title="Latest from NNCO" titleId="featured-blog-title">
        <BlogPostList posts={posts} />
      </SectionAnatomy>
    </SectionFrame>

    <SectionFrame tone="paper" labelledBy="editorial-policy-title" class="editorial-section">
      <SectionAnatomy
        title="What we publish"
        titleId="editorial-policy-title"
      >
        <p class="editorial-section__body">
          We write about how systems work, not about who we built them for.
          There are no client names on this site, no case studies and no
          numbers we cannot stand behind. Where a piece describes a real
          deployment, the sector and the situation are anonymised.
        </p>
      </SectionAnatomy>
    </SectionFrame>

    <ClosingSection
      id="blog-closing"
      tone="surface"
      description="If something here matches a problem you are working on, the fastest way to go further is 30 minutes with the people who wrote it."
      actions={[{ href: "/contact", label: "Book a 30-minute call" }]}
    />
  </main>
  <Footer />
</BaseLayout>
