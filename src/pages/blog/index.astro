---
import BaseLayout from "@/layouts/BaseLayout.astro";
import BlogPostList from "@/components/BlogPostList.astro";
import ClosingSection from "@/components/ClosingSection.astro";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import PageHero from "@/components/PageHero.astro";
import SectionAnatomy from "@/components/SectionAnatomy.astro";
import SectionFrame from "@/components/SectionFrame.astro";
import { getBlogEntries, toBlogPostListItem } from "@/lib/blog";

export const prerender = true;

const posts = (await getBlogEntries()).map(toBlogPostListItem);
---

<BaseLayout
  title="Blog: putting AI into production | NNCo"
  description="How AI systems actually reach production inside large institutions. Field notes, system explanations and working principles from NNCo"
  canonicalPath="/blog"
>
  <Header currentPath="/blog" />
  <main class="news-index editorial-page">
    <PageHero
      title="Blog"
      introduction="How AI systems reach production inside institutions that cannot afford to get it wrong, without client names and without numbers we cannot stand behind."
    />

    <SectionFrame labelledBy="featured-blog-title" class="news-feed">
      <SectionAnatomy title="Latest from NNCo" titleId="featured-blog-title">
        <BlogPostList
          posts={posts}
          variant="load-more"
          initialCount={10}
          batchSize={10}
        />
      </SectionAnatomy>
    </SectionFrame>

    <SectionFrame labelledBy="editorial-policy-title" class="editorial-section">
      <SectionAnatomy
        title="What we publish"
        titleId="editorial-policy-title"
      >
        <p class="editorial-section__body">
          We write about how systems work, not about who we built them for.
          There are no client names on this site, no case studies and no
          numbers we cannot stand behind. Where a piece describes a real
          deployment, the sector and the situation are anonymised.
        </p>
      </SectionAnatomy>
    </SectionFrame>

    <ClosingSection
      id="blog-closing"
      description="If something here matches a problem you are working on, the fastest way to go further is a 30-minute call with NNCo"
      actions={[{ href: "/contact", label: "Book a 30-minute call" }]}
    />
  </main>
  <Footer />
</BaseLayout>
