---
import BaseLayout from "@/layouts/BaseLayout.astro";
import BlockArrow from "@/components/BlockArrow.astro";
import Button from "@/components/Button.astro";
import ClosingSection from "@/components/ClosingSection.astro";
import EditorialCard from "@/components/EditorialCard.astro";
import EditorialCardLayer from "@/components/EditorialCardLayer.astro";
import FaqSection from "@/components/FaqSection.astro";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import PageHero from "@/components/PageHero.astro";
import SectionAnatomy from "@/components/SectionAnatomy.astro";
import SectionFrame from "@/components/SectionFrame.astro";
import { faqByPage } from "@/data/faq";
import { cardGlyphSets } from "@/data/glyphs";
import { team, waysOfWorking } from "@/data/site";
import { buildFaqSchema } from "@/lib/schema";

export const prerender = true;

const faq = faqByPage.company;
const faqSchema = buildFaqSchema(faq, "/company");
---

<BaseLayout
  title="Company: who we are and how we work | NNCo."
  description="NNCo. is an AI consulting and development company. The people behind it have built, sold and operated software and regulated fintech businesses before starting it."
  canonicalPath="/company"
  schemas={[faqSchema]}
>
  <Header />
  <main class="editorial-page">
    <PageHero title="Company" />

    <SectionFrame>
      <div class="company-about__lead-section">
        <span class="section-anatomy__rule" aria-hidden="true"></span>
        <p class="company-about__lead">
          Large institutions have no shortage of AI pilots. The challenge is
          getting them <span class="company-about__highlight" style="--highlight-index: 0"><span>into production</span></span>.
          A workshop identifies a use case, and an agency proves that it can
          work. Then the difficult part begins. Production requires integration
          with <span class="company-about__highlight" style="--highlight-index: 1"><span>existing systems</span></span>,
          controls that keep <span class="company-about__highlight" style="--highlight-index: 2"><span>restricted
            data</span></span> where it belongs, <span
            class="company-about__highlight" style="--highlight-index: 3"><span>evidence</span></span> the organisation can
          rely on and <span class="company-about__highlight" style="--highlight-index: 4"><span>clear ownership</span></span>
          after launch. A working model is not enough. It also has to work inside
          the institution.
        </p>
      </div>
    </SectionFrame>

    <SectionFrame labelledBy="why-title">
      <SectionAnatomy title="Implementation gap" titleId="why-title">
        <div class="company-about__supporting">
          <p class="editorial-section__body">
            That gap is an implementation problem, and it looks exactly like
            the problems we spent the last decade solving: integrating with
            systems nobody wants to touch, shipping into an environment with
            real users and real consequences, and staying responsible for it
            afterwards. We had done that inside a licensed lending platform,
            inside a software company delivering for banks and insurers, and
            in security audits where being approximately right is the same as
            being wrong.
          </p>
          <p class="editorial-section__body">
            So NNCo. does the whole arc. We find where AI is worth building, we
            build it, we deploy it inside your constraints, and we run it after
            launch. Strategy without deployment is a document. Deployment
            without an understanding of the rules is a pilot that gets stopped.
          </p>
        </div>
      </SectionAnatomy>
    </SectionFrame>

    <SectionFrame id="team" labelledBy="team-title" class="team-section">
      <SectionAnatomy title="Meet the team" titleId="team-title">
        <div class="team-grid team-grid--detailed">
          {
            team.map((person) => (
              <article class="team-card">
                <div class="team-card__portrait">
                  <img
                    src={person.image}
                    alt={`Portrait of ${person.name}`}
                    width="1254"
                    height="1254"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
                <div class="team-card__content">
                  <h3>{person.name}</h3>
                  <p class="team-grid__role">{person.role}</p>
                  <p>{person.bio}</p>
                </div>
              </article>
            ))
          }
        </div>
      </SectionAnatomy>
    </SectionFrame>

    <SectionFrame labelledBy="position-title" class="editorial-section">
      <SectionAnatomy title="Our position" titleId="position-title">
        <p class="editorial-section__body">
          Consultancies produce the strategy and hand over the implementation.
          Agencies produce the demonstration and hand over the problems. We
          cover both halves and stay accountable for the result, which is a
          smaller and less scalable business than either of them and the reason
          the work reaches production.
        </p>
      </SectionAnatomy>
    </SectionFrame>

    <SectionFrame labelledBy="work-title" class="company-work">
      <SectionAnatomy title="How we work" titleId="work-title" contentWidth="50">
        <EditorialCardLayer colSize={1}>
          {
            waysOfWorking.map((item, index) => (
              <EditorialCard
                title={item.title}
                text={item.description}
                glyph={cardGlyphSets.companyWaysOfWorking[index]}
              />
            ))
          }
        </EditorialCardLayer>
      </SectionAnatomy>
    </SectionFrame>

    <SectionFrame tone="dark" labelledBy="discretion-title" class="editorial-section">
      <SectionAnatomy title="Client confidentiality" titleId="discretion-title">
        <p class="editorial-section__body">
          We sign an NDA before you describe anything internal. What we build for
          one institution is not visible to another, including the architecture
          and the detail that came with it. Whether to speak about the work
          publicly is the client's decision, and the answer is usually no.
        </p>
        <p class="editorial-section__body">
          We are precise about how we work and quiet about who we work for.
          Architecture, method, evidence model and constraints are all on this
          site in detail. Names, logos and case studies are not, and a reference
          conversation happens one to one when you need it.
        </p>
      </SectionAnatomy>
    </SectionFrame>

    <SectionFrame labelledBy="where-title" class="editorial-section">
      <SectionAnatomy title="European reach" titleId="where-title">
        <p class="editorial-section__body">
          Engagements run in Czech, Slovak and English. The regulatory context
          we know best is the European one, which is where the constraints are
          strictest and the implementations are hardest.
        </p>
        <div class="editorial-links">
          <Button href="/ai-first-enterprise" variant="secondary">AI-First Enterprise <BlockArrow /></Button>
          <Button href="/blog" variant="secondary">Read the blog <BlockArrow /></Button>
        </div>
      </SectionAnatomy>
    </SectionFrame>

    <FaqSection items={faq} />

    <ClosingSection
      description="No slides, and you talk to the people who would do the work. If it is not something we should build, you will hear that on the call rather than in a proposal."
      actions={[{ href: "/contact", label: "Book a 30-minute call" }]}
    />
  </main>
  <Footer />
  <script>
    const initialiseCompanyThesis = () => {
      const companyThesis = document.querySelector<HTMLElement>(
        ".company-about__lead",
      );
      if (
        !companyThesis ||
        companyThesis.dataset.companyThesisReady === "true"
      ) {
        return;
      }

      companyThesis.dataset.companyThesisReady = "true";
      const reducedMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      );

      if (!reducedMotion.matches) {
        const highlightObserver = new IntersectionObserver(
          ([entry]) => {
            if (!entry.isIntersecting) return;
            companyThesis.classList.add("is-highlight-visible");
            highlightObserver.disconnect();
          },
          { threshold: 0.3 },
        );

        const observeHighlights = () => {
          highlightObserver.observe(companyThesis);
        };

        if (document.querySelector("[data-page-loader]")) {
          window.addEventListener("nnco:page-ready", observeHighlights, {
            once: true,
          });
        } else {
          observeHighlights();
        }

        document.addEventListener(
          "astro:before-swap",
          () => highlightObserver.disconnect(),
          { once: true },
        );
      }
    };

    initialiseCompanyThesis();
    document.addEventListener("astro:page-load", initialiseCompanyThesis);
  </script>
</BaseLayout>
