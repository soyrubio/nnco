---
import BaseLayout from "@/layouts/BaseLayout.astro";
import BlockArrow from "@/components/BlockArrow.astro";
import BlogPostList from "@/components/BlogPostList.astro";
import Button from "@/components/Button.astro";
import ClosingSection from "@/components/ClosingSection.astro";
import EditorialCard from "@/components/EditorialCard.astro";
import EditorialCardLayer from "@/components/EditorialCardLayer.astro";
import FaqSection from "@/components/FaqSection.astro";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import Hero from "@/components/Hero.astro";
import MarketingBehavior from "@/components/MarketingBehavior.astro";
import PrivateAiBoundary from "@/components/PrivateAiBoundary.astro";
import SectionAnatomy from "@/components/SectionAnatomy.astro";
import SectionFrame from "@/components/SectionFrame.astro";
import { faqByPage } from "@/data/faq";
import { homeBuildItems } from "@/data/home";
import { homePhases } from "@/data/programme";
import { sectors } from "@/data/site";
import { getBlogEntries, toBlogPostListItem } from "@/lib/blog";
import { buildFaqSchema } from "@/lib/schema";

export const prerender = true;

const faq = faqByPage.home;
const latestPosts = (await getBlogEntries()).slice(0, 3).map(toBlogPostListItem);
const websiteSchema = {
  "@type": "WebSite",
  "@id": "https://nnco.ai/#website",
  url: "https://nnco.ai",
  name: "NNCo.",
  publisher: { "@id": "https://nnco.ai/#organization" },
  inLanguage: "en",
};
const faqSchema = buildFaqSchema(faq, "/");
---

<BaseLayout
  title="AI consulting and development for large institutions | NNCo."
  description="NNCo. designs, integrates and operates AI systems for banks, insurers and healthcare providers. We start with an AI audit and take the first use case into production."
  canonicalPath="/"
  schemas={[websiteSchema, faqSchema]}
  preloadImages={[
    {
      href: "/assets/hero-sequence/mobile/frame-01.webp",
      media: "(max-width: 767px)",
      type: "image/webp",
    },
    {
      href: "/assets/hero-sequence/desktop/frame-01.webp",
      media: "(min-width: 768px)",
      type: "image/webp",
    },
  ]}
>
  <MarketingBehavior />
  <Header overHero />

  <main>
    <Hero />

    <SectionFrame labelledBy="audit-title" class="editorial-section">
      <SectionAnatomy title="AI audit" titleId="audit-title">
        <p class="editorial-section__body">
          The audit goes through your operations and returns a map: what to
          build, in what order, and what each one is worth. It states where
          your data and your regulator allow deployment and where they do not.
          The first use case goes straight into a pilot.
        </p>
        <div class="editorial-links">
          <Button href="/ai-first-enterprise/ai-audit" variant="secondary">
            How the audit works <BlockArrow />
          </Button>
        </div>
      </SectionAnatomy>
    </SectionFrame>

    <SectionFrame labelledBy="build-title">
      <SectionAnatomy title="What we build" titleId="build-title">
        <EditorialCardLayer colSize={1}>
          {
            homeBuildItems.map((item) => (
              <EditorialCard
                title={item.title}
                text={item.description}
                glyph={item.glyph}
              />
            ))
          }
        </EditorialCardLayer>
      </SectionAnatomy>
    </SectionFrame>

    <SectionFrame labelledBy="gain-title" class="editorial-section">
      <SectionAnatomy title="Operational capacity" titleId="gain-title">
        <p class="editorial-section__body">
          Work that takes people hours or days runs in minutes. Onboarding,
          document handling, reporting, internal operations. This is capacity
          you would otherwise have to hire for.
        </p>
      </SectionAnatomy>
    </SectionFrame>

    <SectionFrame tone="dark" ariaLabel="Private AI" class="private-ai-section">
      <span class="section-anatomy__rule" aria-hidden="true"></span>
      <div class="infrastructure-plate">
        <div class="infrastructure-plate__content">
          <div class="infrastructure-plate__copy">
            <p>
              Models, retrieval, access control and monitoring run inside the
              environment you govern. On-premise when data residency or
              regulation requires it. When it is not required, we do not
              deploy it.
            </p>
            <Button href="/ai-first-enterprise/private-ai" variant="secondary">
              Private AI <BlockArrow />
            </Button>
          </div>
        </div>
        <PrivateAiBoundary />
      </div>
    </SectionFrame>

    <SectionFrame id="industries" labelledBy="industries-title" class="home-sectors">
      <SectionAnatomy title="Industries" titleId="industries-title">
        <EditorialCardLayer colSize={2} surface="bordered">
          {
            sectors.map((sector) => (
              <EditorialCard
                title={sector.name}
                text={sector.description}
                href={sector.href}
              />
            ))
          }
        </EditorialCardLayer>
      </SectionAnatomy>
    </SectionFrame>

    <SectionFrame labelledBy="production-title" class="approach-section">
      <SectionAnatomy title="From pilot to production" titleId="production-title">
        <div>
          <p class="editorial-section__body">
            We build the part that gets it past the pilot: integration into
            the systems people already use, evidence behind every step, and a
            named owner after launch. Where data has to stay inside, it stays
            inside.
          </p>
          <Button href="/ai-first-enterprise" variant="secondary">
            How we work <BlockArrow />
          </Button>
        </div>
      </SectionAnatomy>
    </SectionFrame>

    <SectionFrame labelledBy="discretion-title" class="editorial-section">
      <SectionAnatomy title="Client confidentiality" titleId="discretion-title">
        <p class="editorial-section__body">
          What we build for one institution is not visible to another. Whether
          to speak about the work publicly is the client's decision, and the
          answer is usually no.
        </p>
      </SectionAnatomy>
    </SectionFrame>

    <SectionFrame
      labelledBy="sequence-title"
      class="editorial-section home-operation-sequence"
    >
      <SectionAnatomy
        title="From audit to operation"
        titleId="sequence-title"
        contentWidth="50"
      >
        <EditorialCardLayer colSize={1}>
          {
            homePhases.map((phase) => (
              <EditorialCard
                title={phase.title}
                text={phase.text}
                href={"href" in phase ? phase.href : undefined}
              />
            ))
          }
        </EditorialCardLayer>
      </SectionAnatomy>
    </SectionFrame>

    <SectionFrame labelledBy="blog-title" class="home-latest-news">
      <SectionAnatomy title="In practice" titleId="blog-title">
        <BlogPostList
          posts={latestPosts}
          ariaLabel="Latest NNCo. blog posts"
          variant="latest"
        />
      </SectionAnatomy>
    </SectionFrame>

    <FaqSection items={faq} />

    <ClosingSection
      description="No slides. We go through where AI would pay off first in your operation, what it would take to run it, and what your data and your regulator allow."
      actions={[{ href: "/contact", label: "Book a 30-minute call" }]}
    />
  </main>

  <Footer />
</BaseLayout>
