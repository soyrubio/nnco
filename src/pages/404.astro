---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Button from "@/components/Button.astro";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import NotFoundGame from "@/components/NotFoundGame.astro";

export const prerender = true;
---

<BaseLayout title="Page not found | NNCo" description="The requested page does not exist." noindex>
  <Header />
  <main class="not-found-page" aria-labelledby="page-title">
    <div class="content-rail not-found-page__inner">
      <h1 id="page-title">Page not found</h1>
      <div class="not-found-page__content">
        <p class="not-found-page__introduction">
          The link may be old, or the page may have moved.
        </p>
        <nav class="editorial-actions" aria-label="Useful pages">
          <Button href="/" variant="secondary">Home</Button>
          <Button href="/ai-first-enterprise" variant="secondary">
            AI-First Enterprise
          </Button>
          <Button href="/banking" variant="secondary">Banking</Button>
          <Button href="/blog" variant="secondary">Blog</Button>
          <Button href="/contact" variant="secondary">Contact</Button>
        </nav>
        <NotFoundGame />
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>
