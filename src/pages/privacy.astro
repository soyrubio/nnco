---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import PageHero from "@/components/PageHero.astro";
import SectionAnatomy from "@/components/SectionAnatomy.astro";
import SectionFrame from "@/components/SectionFrame.astro";
import TerminalSection from "@/components/TerminalSection.astro";

export const prerender = true;
---

<BaseLayout
  title="Privacy | NNCo."
  description="How the NNCo. website handles contact enquiries and workflow diagnostic data."
  canonicalPath="/privacy"
  noindex
>
  <Header />
  <main class="editorial-page">
    <PageHero
      title="Privacy"
      introduction="This page describes what NNCo. collects through this website, where diagnostic data goes and how long it is kept. Client engagement data is governed separately by the agreement and data processing terms signed with that client."
    />
    <SectionFrame labelledBy="website-data-title" class="editorial-section">
      <SectionAnatomy title="What this website collects" titleId="website-data-title">
        <p class="editorial-section__body">
          The contact form stores the details you submit so NNCo. can respond to
          your enquiry. NNCo. is the controller for data collected on this
          website. You can ask about, correct or request deletion of that data
          at <a href="mailto:general@nnco.ai">general@nnco.ai</a>.
        </p>
      </SectionAnatomy>
    </SectionFrame>
    <SectionFrame labelledBy="diagnostic-data-title" class="editorial-section">
      <SectionAnatomy title="Before you submit" titleId="diagnostic-data-title">
        <p class="editorial-section__body">
          When you enter a company website, our server reads up to three public
          pages from that site. The public page text and website address may be
          processed by OpenAI to identify the company context. Public page text
          can remain in a temporary server
          memory cache for up to 24 hours. No lead record is created until you
          submit the final contact step.
        </p>
      </SectionAnatomy>
    </SectionFrame>
    <SectionFrame labelledBy="submitted-data-title" class="editorial-section">
      <SectionAnatomy title="When you generate a report" titleId="submitted-data-title">
        <p class="editorial-section__body">
          We store your work email, organisation context when provided, the
          submission acknowledgement and diagnostic answers so we can produce the result and follow up once
          about it. The report is generated by OpenAI. If you request the
          optional market comparison, OpenAI also searches public web sources.
          We do not store fetched HTML in the lead record. The completed report
          is kept with the submitted record so an interrupted retry returns the
          same result without running the analysis again.
        </p>
      </SectionAnatomy>
    </SectionFrame>
    <SectionFrame labelledBy="processor-title" class="editorial-section">
      <SectionAnatomy title="AI processing" titleId="processor-title">
        <p class="editorial-section__body">
          NNCo. sends diagnostic content to OpenAI through its business API with
          response storage disabled. OpenAI states that API data is not used to
          train its models by default and that abuse-monitoring logs may be kept
          for up to 30 days. See OpenAI's <a
            href="https://developers.openai.com/api/docs/guides/your-data/"
            target="_blank"
            rel="noreferrer"
          >API data controls</a>. Do not enter customer, patient, personal or
          confidential case data in the diagnostic.
        </p>
      </SectionAnatomy>
    </SectionFrame>
    <SectionFrame labelledBy="abuse-prevention-title" class="editorial-section">
      <SectionAnatomy title="Abuse prevention" titleId="abuse-prevention-title">
        <p class="editorial-section__body">
          To keep website reading and report generation available, NNCo. keeps
          keyed hashes derived from the requesting IP address and work email,
          together with request times, for no more than two days. The raw IP
          address and email are not stored in this limiter table. The final
          lawful-basis and recipient wording remains part of the legal launch
          review below.
        </p>
      </SectionAnatomy>
    </SectionFrame>
    <SectionFrame labelledBy="legal-review-title" class="editorial-section">
      <SectionAnatomy title="Legal notice status" titleId="legal-review-title">
        <p class="editorial-section__body">
          The controller's full legal identity and address, lawful-basis
          wording, international-transfer details, complete rights and
          supervisory-authority route still require legal approval before this
          notice is indexed or the diagnostic is publicly launched.
        </p>
      </SectionAnatomy>
    </SectionFrame>
    <TerminalSection
      title="Retention"
      titleId="retention-title"
      class="editorial-section"
    >
      <p class="editorial-section__body">
        Contact and submitted diagnostic records are deleted after 90 days.
        We may keep a record longer only when it becomes part of a client
        engagement or a legal obligation requires it. You can request earlier
        deletion at <a href="mailto:general@nnco.ai">general@nnco.ai</a>.
      </p>
    </TerminalSection>
  </main>
  <Footer />
</BaseLayout>
