---
import BaseLayout from "@/layouts/BaseLayout.astro";
import BlockArrow from "@/components/BlockArrow.astro";
import Button from "@/components/Button.astro";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import SectionAnatomy from "@/components/SectionAnatomy.astro";
import { getNewsArticle, newsArticles, type NewsArticle } from "@/data/news";

export const prerender = true;

export function getStaticPaths() {
  return newsArticles.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

interface Props {
  article: NewsArticle;
}

const { article } = Astro.props;
const related = getNewsArticle(article.relatedSlug);
---

<BaseLayout
  title={`${article.title} | NNCO`}
  description={article.summary}
>
  <Header currentPath="/news" />
  <main class="news-article">
    <header class="news-article__header">
      <div class="content-rail">
        <a class="news-back-link" href="/news">
          <BlockArrow direction="left" />
          All news
        </a>
        <div class="news-meta">
          <span>{article.category}</span>
          <time datetime={article.publishedAt}>{article.publishedLabel}</time>
        </div>
        <h1>{article.title}</h1>
      </div>
    </header>

    <article class="news-article__body">
      {
        article.sections.map((section) => (
          <section>
            <SectionAnatomy title={section.heading} class="article-anatomy">
              <div class="news-reading-copy">
                {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
              </div>
            </SectionAnatomy>
          </section>
        ))
      }

      <SectionAnatomy title="Key statement" class="article-anatomy">
        <blockquote>
          <p>{article.keyStatement}</p>
        </blockquote>
      </SectionAnatomy>
    </article>

    {
      related && (
        <section class="news-related" aria-labelledby="related-title">
          <div class="content-rail">
            <SectionAnatomy
              title="Related perspective"
              titleId="related-title"
            >
              <a href={`/news/${related.slug}`}>
                <span>
                  {related.category} / {related.publishedLabel}
                </span>
                <h3>{related.title}</h3>
                <p>{related.summary}</p>
                <span class="news-read-link">
                  Read next <BlockArrow />
                </span>
              </a>
            </SectionAnatomy>
          </div>
        </section>
      )
    }

    <section class="news-closing" aria-labelledby="news-closing-title">
      <div class="content-rail">
        <SectionAnatomy
          title="Apply the perspective"
          titleId="news-closing-title"
        >
          <div class="news-closing__content">
            <h3>
              Start with the workflow and the constraint that makes it difficult.
            </h3>
            <div>
              <Button href="/discovery">
                Start diagnostic <BlockArrow />
              </Button>
              <Button href="/contact" variant="secondary">
                Contact NNCO <BlockArrow />
              </Button>
            </div>
          </div>
        </SectionAnatomy>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
