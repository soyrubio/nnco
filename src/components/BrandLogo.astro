---
import { PRIMARY_LOGO } from "@/lib/brand-assets";

interface Props {
  href?: string;
  eager?: boolean;
  variant?: "primary" | "alternate" | "previous";
  class?: string;
}

const {
  href = "/",
  eager = false,
  variant = "primary",
  class: className,
} = Astro.props;

const source =
  variant === "alternate"
    ? "/assets/nnco-logo-legacy-alternate.svg"
    : variant === "previous"
      ? "/assets/nnco-logo-legacy-primary.svg"
      : PRIMARY_LOGO.src;
const sourceWidth = variant === "primary" ? PRIMARY_LOGO.width : 900;
const sourceHeight = PRIMARY_LOGO.height;
---

<a
  class:list={[
    "brand-logo",
    { "brand-logo--wide": variant !== "primary" },
    className,
  ]}
  href={href}
  aria-label="NNCo home"
>
  <span class="brand-logo__stage" aria-hidden="true">
    <img
      src={source}
      alt=""
      width={sourceWidth}
      height={sourceHeight}
      loading={eager ? "eager" : "lazy"}
      fetchpriority={eager ? "high" : "auto"}
    />
  </span>
</a>
