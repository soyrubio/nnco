---
import BlockArrow from "./BlockArrow.astro";
import Button from "./Button.astro";

const desktopFrames = Array.from(
  { length: 11 },
  (_, index) =>
    `/assets/hero-sequence/desktop/frame-${String(index + 1).padStart(2, "0")}.webp`,
);
const mobileFrames = Array.from(
  { length: 11 },
  (_, index) =>
    `/assets/hero-sequence/mobile/frame-${String(index + 1).padStart(2, "0")}.webp`,
);
---

<section class="hero" aria-labelledby="hero-title" data-marketing-hero>
  <div class="content-rail hero__inner">
    <div class="hero__copy">
      <h1 id="hero-title">
        <span class="hero__headline-line">We design, integrate and</span>
        <span class="hero__headline-line">operate AI systems.</span>
      </h1>
      <p class="hero__introduction">
        We show large institutions where AI pays off first, then build it and
        run it in production. Including where data cannot leave the building
        and every decision has to survive an audit.
      </p>
      <div class="hero__actions">
        <Button href="/contact">
          Book a 30-minute call
          <BlockArrow />
        </Button>
        <Button
          href="/discovery"
          variant="secondary"
        >
          Start the diagnostic
          <BlockArrow />
        </Button>
      </div>
    </div>
  </div>

  <div
    class="hero__media"
    aria-hidden="true"
    data-hero-sequence
    data-desktop-frames={desktopFrames.join(" ")}
    data-mobile-frames={mobileFrames.join(" ")}
  >
    <picture class="hero__picture">
      <source
        data-hero-sequence-mobile
        media="(max-width: 767px)"
        srcset={mobileFrames[0]}
        width="48"
        height="85"
      />
      <img
        class="hero__image"
        data-hero-sequence-image
        src={desktopFrames[0]}
        alt=""
        width="128"
        height="72"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </picture>
  </div>
  <div class="hero__scrim" aria-hidden="true"></div>
  <div class="hero__top-gradient" aria-hidden="true"></div>
</section>

<script>
  const sequenceRoot =
    document.querySelector<HTMLElement>("[data-hero-sequence]");

  if (sequenceRoot && sequenceRoot.dataset.sequenceReady !== "true") {
    sequenceRoot.dataset.sequenceReady = "true";

    const image = sequenceRoot.querySelector<HTMLImageElement>(
      "[data-hero-sequence-image]",
    );
    const mobileSource = sequenceRoot.querySelector<HTMLSourceElement>(
      "[data-hero-sequence-mobile]",
    );
    const desktopFrames = (sequenceRoot.dataset.desktopFrames ?? "")
      .split(" ")
      .filter(Boolean);
    const mobileFrames = (sequenceRoot.dataset.mobileFrames ?? "")
      .split(" ")
      .filter(Boolean);
    const mobileViewport = window.matchMedia("(max-width: 767px)");
    const reducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    );
    const holdMs = 100;
    const cadenceMs = [50, 60, 70, 80, 90, 100, 120, 150, 200, 280];
    const loadedSequences = new Set<string>();
    const timers: number[] = [];
    let holdTimer = 0;
    let hasPlayed = false;
    let activeFrame = 0;

    const getActiveSequence = () =>
      mobileViewport.matches ? mobileFrames : desktopFrames;

    const preloadSequence = async (frames: string[]) => {
      const key = frames[0];
      if (!key || loadedSequences.has(key)) return true;

      const results = await Promise.all(
        frames.slice(1).map(
          (src) =>
            new Promise<boolean>((resolve) => {
              const preload = new Image();
              preload.onload = () => resolve(true);
              preload.onerror = () => resolve(false);
              preload.src = src;
            }),
        ),
      );
      const didLoad = results.every(Boolean);
      if (didLoad) loadedSequences.add(key);
      return didLoad;
    };

    const clearSequenceTimers = () => {
      window.clearTimeout(holdTimer);
      holdTimer = 0;
      timers.splice(0).forEach((timer) => window.clearTimeout(timer));
    };

    const applyFrame = (index: number) => {
      if (!image || !mobileSource) return;
      const frames = getActiveSequence();
      const src = frames[index];
      if (!src) return;

      activeFrame = index;
      if (mobileViewport.matches) {
        mobileSource.srcset = src;
      } else {
        image.src = src;
      }
    };

    const playSequence = async () => {
      if (hasPlayed || reducedMotion.matches || !image || !mobileSource) return;
      hasPlayed = true;
      const readyAt = performance.now();

      let frames = getActiveSequence();
      if (frames.length !== 11 || !(await preloadSequence(frames))) return;
      const currentFrames = getActiveSequence();
      if (currentFrames[0] !== frames[0]) {
        frames = currentFrames;
        if (frames.length !== 11 || !(await preloadSequence(frames))) return;
      }
      if (reducedMotion.matches) return;

      const remainingHold = Math.max(0, holdMs - (performance.now() - readyAt));
      holdTimer = window.setTimeout(() => {
        holdTimer = 0;
        let elapsed = 0;
        frames.slice(1).forEach((_, index) => {
          elapsed += cadenceMs[index];
          timers.push(window.setTimeout(() => applyFrame(index + 1), elapsed));
        });
      }, remainingHold);
    };

    const handleMotionPreference = () => {
      if (!reducedMotion.matches) return;
      clearSequenceTimers();
      applyFrame(0);
    };

    const handleViewportChange = () => {
      if (!hasPlayed) return;
      clearSequenceTimers();
      applyFrame(activeFrame);
    };

    if (!reducedMotion.matches) {
      void preloadSequence(getActiveSequence());
    }

    if (document.querySelector("[data-page-loader]")) {
      window.addEventListener("nnco:page-ready", playSequence, { once: true });
    } else {
      window.requestAnimationFrame(() => {
        void playSequence();
      });
    }

    document.addEventListener(
      "astro:before-swap",
      () => {
        clearSequenceTimers();
        reducedMotion.removeEventListener("change", handleMotionPreference);
        mobileViewport.removeEventListener("change", handleViewportChange);
        window.removeEventListener("nnco:page-ready", playSequence);
      },
      { once: true },
    );

    reducedMotion.addEventListener("change", handleMotionPreference);
    mobileViewport.addEventListener("change", handleViewportChange);
  }
</script>
