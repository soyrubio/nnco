---
import BlockArrow from "./BlockArrow.astro";
import Button from "./Button.astro";
import ClosingSection from "./ClosingSection.astro";
import EditorialCard from "./EditorialCard.astro";
import EditorialCardLayer from "./EditorialCardLayer.astro";
import ExpandedDetailList from "./ExpandedDetailList.astro";
import FaqSection from "./FaqSection.astro";
import Footer from "./Footer.astro";
import Header from "./Header.astro";
import PageHero from "./PageHero.astro";
import SectionAnatomy from "./SectionAnatomy.astro";
import SectionFrame from "./SectionFrame.astro";
import type { LinkAction } from "./types";
import { faqByPage } from "@/data/faq";
import type { MarketingPageData } from "@/data/programme";
import { waysOfWorking } from "@/data/site";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { buildFaqSchema } from "@/lib/schema";

interface Props {
  page: MarketingPageData;
  industry?: boolean;
}

const { page, industry = false } = Astro.props;
const faq = faqByPage[page.faqKey];
const isDarkPage = page.tone === "dark";
const heroActions: LinkAction[] = [];
if (page.primaryAction) {
  heroActions.push({ ...page.primaryAction, variant: "primary" });
}
if (page.secondaryAction) {
  heroActions.push({ ...page.secondaryAction, variant: "secondary" });
}
const faqSchema = buildFaqSchema(faq, page.path);
const serviceSchema = page.service
  ? {
      "@type": "Service",
      "@id": `https://nnco.ai${page.path}#service`,
      name: page.service.name,
      serviceType: page.service.serviceType,
      description: page.service.description,
      provider: { "@id": "https://nnco.ai/#organization" },
      areaServed: "EU",
    }
  : undefined;
const breadcrumbSchema = industry
  ? {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://nnco.ai/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Industries",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: page.service?.name ?? page.title,
          item: `https://nnco.ai${page.path}`,
        },
      ],
    }
  : undefined;
const schemas = [serviceSchema, faqSchema, breadcrumbSchema].filter(
  Boolean,
) as Record<string, unknown>[];
---

<BaseLayout
  title={page.metaTitle}
  description={page.metaDescription}
  canonicalPath={page.path}
  schemas={schemas}
  tone={page.tone}
>
  <Header overHero={isDarkPage} />
  <main
    class:list={["editorial-page", isDarkPage && "editorial-page--dark"]}
    data-header-tone={isDarkPage ? "dark" : undefined}
  >
    <PageHero
      title={page.title}
      introduction={page.introduction}
      actions={heroActions}
      class={isDarkPage ? "editorial-hero--dark" : undefined}
    />

    {
      page.sections.map((section, index) => {
        const titleId = `section-${index + 1}`;
        const contentWidth = section.contentWidth
          ?? (section.render === "ways-of-working" ? "50" : undefined);

        if (section.render === "highlighted-lead") {
          return (
            <SectionFrame
              tone={page.tone}
              ariaLabel={section.title}
              class="private-ai-lead-section"
            >
              <div class="private-ai-lead">
                <span class="section-anatomy__rule" aria-hidden="true"></span>
                <p class="private-ai-lead__copy">
                  {section.lead?.map((segment) => (
                    segment.highlight
                      ? <span class="private-ai-lead__highlight">{segment.text}</span>
                      : segment.text
                  ))}
                </p>
              </div>
            </SectionFrame>
          );
        }

        return (
          <SectionFrame
            tone={page.tone}
            labelledBy={titleId}
            class="editorial-section"
          >
            <SectionAnatomy
              title={section.title}
              titleId={titleId}
              contentWidth={contentWidth}
            >
              {section.paragraphs?.map((paragraph) => (
                <p class="editorial-section__body">{paragraph}</p>
              ))}
              {section.render === "ways-of-working" && (
                <ExpandedDetailList items={waysOfWorking} />
              )}
              {section.groups && (
                <div
                  class:list={[
                    "editorial-group-grid",
                    section.groupLayout === "stacked-numbered"
                      && "editorial-group-grid--stacked-numbered",
                  ]}
                >
                  {section.groups.map((group) => (
                    <div class="editorial-group">
                      <h3>{group.title}</h3>
                      <ul>
                        {group.items.map((item) => <li>{item}</li>)}
                      </ul>
                    </div>
                  ))}
                </div>
              )}
              {section.items && (
                <EditorialCardLayer
                  colSize={section.cards?.columns
                    ?? (section.items.length === 2 || section.items.length === 4 ? 2 : 3)}
                  surface={section.cards?.surface}
                  class={section.cards?.className}
                >
                  {section.items.map((item, itemIndex) => (
                    <EditorialCard
                      title={item.title}
                      text={item.text}
                      href={item.href}
                      glyph={section.cards?.glyphs?.[itemIndex]}
                    />
                  ))}
                </EditorialCardLayer>
              )}
              {section.links && (
                <div class="editorial-links">
                  {section.links.map((link) => (
                    <Button href={link.href} variant="secondary">
                      {link.label} <BlockArrow />
                    </Button>
                  ))}
                </div>
              )}
            </SectionAnatomy>
          </SectionFrame>
        );
      })
    }

    <FaqSection items={faq} />

    <ClosingSection
      description={page.closing}
      actions={[{ href: "/contact", label: "Book a 30-minute call" }]}
    />
  </main>
  <Footer tone={page.tone} />
</BaseLayout>
