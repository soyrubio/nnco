---
import CardAffordance from "./CardAffordance.astro";
import ModularGlyph from "./ModularGlyph.astro";
import type {
  ModularGlyphCell,
  ModularGlyphSymmetry,
} from "@/lib/modular-glyph";

interface Props {
  title: string;
  text: string;
  href?: string;
  glyph?: {
    gridSize: number;
    cells: readonly ModularGlyphCell[];
    symmetry: ModularGlyphSymmetry;
  };
}

const {
  title,
  text,
  href,
  glyph,
} = Astro.props;

const Element = href ? "a" : "article";
---

<Element
  class:list={[
    "editorial-card",
    glyph && "editorial-card--with-glyph",
  ]}
  href={href}
  data-viewport-motion
>
  {
    glyph && (
      <div class="editorial-card__glyph">
        <ModularGlyph
          gridSize={glyph.gridSize}
          cells={glyph.cells}
          symmetry={glyph.symmetry}
        />
      </div>
    )
  }
  <h3 data-viewport-motion-item>{title}</h3>
  <p
    data-viewport-motion-item
    style="--viewport-motion-delay: 140ms"
  >
    {text}
  </p>
  {href && <CardAffordance />}
</Element>
