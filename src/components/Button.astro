---
interface Props {
  href?: string;
  variant?: "primary" | "secondary" | "quiet";
  size?: "small" | "regular";
  type?: "button" | "submit" | "reset";
  target?: "_blank" | "_self";
  rel?: string;
  class?: string;
  "aria-label"?: string;
}

const {
  href,
  variant = "primary",
  size = "regular",
  type = "button",
  target,
  rel,
  class: className,
  "aria-label": ariaLabel,
} = Astro.props;

const classes = [
  "button",
  `button--${variant}`,
  `button--${size}`,
  className,
];
---

{
  href ? (
    <a class:list={classes} href={href} target={target} rel={rel} aria-label={ariaLabel}>
      <slot />
    </a>
  ) : (
    <button class:list={classes} type={type} aria-label={ariaLabel}>
      <slot />
    </button>
  )
}
