---
const loaderFrames = [
  "/assets/nnco-loader-frame-01.svg",
  "/assets/nnco-loader-frame-02.svg",
  "/assets/nnco-loader-frame-03.svg",
] as const;
---

<div
  class="page-loader"
  data-page-loader
  role="status"
  aria-live="polite"
  aria-label="Loading NNCO"
>
  <span
    class="page-loader__sequence"
    data-page-loader-sequence
    aria-hidden="true"
  >
    {
      loaderFrames.map((src, index) => (
        <img
          class:list={[
            "page-loader__frame",
            { "is-active": index === 0 },
          ]}
          src={src}
          alt=""
          width="300"
          height="300"
          loading="eager"
          fetchpriority="high"
        />
      ))
    }
  </span>
</div>

<style>
  .page-loader__sequence {
    position: relative;
    display: block;
    width: clamp(112px, 12vw, 176px);
    aspect-ratio: 1;
    overflow: hidden;
  }

  .page-loader__frame {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    animation: none;
    transform: none;
    transition: none;
    visibility: hidden;
  }

  .page-loader__frame.is-active {
    visibility: visible;
  }
</style>

<script>
  const frameCadenceMs = 240;
  const minimumVisibleMs = 3000;
  const exitDurationMs = 240;
  const loadSafetyMs = 8000;
  const loader = document.querySelector<HTMLElement>("[data-page-loader]");

  if (loader) {
    const frames = Array.from(
      loader.querySelectorAll<HTMLElement>(".page-loader__frame"),
    );
    const motionPreference = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    );
    const startedAt = performance.now();
    let activeFrame = 0;
    let frameTimer = 0;
    let dismissed = false;
    let removalTimer = 0;
    let minimumTimer = 0;

    const showFrame = (index: number) => {
      frames.forEach((frame, candidate) => {
        frame.classList.toggle("is-active", candidate === index);
      });
    };

    const syncMotionPreference = () => {
      window.clearInterval(frameTimer);
      frameTimer = 0;
      activeFrame = 0;
      showFrame(activeFrame);

      if (!motionPreference.matches && frames.length > 1) {
        frameTimer = window.setInterval(() => {
          activeFrame = (activeFrame + 1) % frames.length;
          showFrame(activeFrame);
        }, frameCadenceMs);
      }
    };

    const cleanup = () => {
      window.removeEventListener("load", dismissAfterMinimum);
      motionPreference.removeEventListener("change", syncMotionPreference);
      window.clearInterval(frameTimer);
      window.clearTimeout(safetyTimer);
      window.clearTimeout(minimumTimer);
      window.clearTimeout(removalTimer);
    };

    const finishExit = () => {
      cleanup();
      loader.remove();
      window.dispatchEvent(new Event("nnco:page-ready"));
    };

    const beginExit = () => {
      if (dismissed) return;
      dismissed = true;

      if (motionPreference.matches) {
        finishExit();
        return;
      }

      loader.classList.add("is-leaving");
      removalTimer = window.setTimeout(finishExit, exitDurationMs);
    };

    const dismissAfterMinimum = () => {
      if (dismissed || minimumTimer) return;
      const remaining = Math.max(
        0,
        minimumVisibleMs - (performance.now() - startedAt),
      );
      minimumTimer = window.setTimeout(beginExit, remaining);
    };

    if (document.readyState === "complete") {
      dismissAfterMinimum();
    } else {
      window.addEventListener("load", dismissAfterMinimum, { once: true });
    }

    const safetyTimer = window.setTimeout(dismissAfterMinimum, loadSafetyMs);
    syncMotionPreference();
    motionPreference.addEventListener("change", syncMotionPreference);

    document.addEventListener(
      "astro:before-swap",
      () => {
        cleanup();
      },
      { once: true },
    );
  }
</script>
