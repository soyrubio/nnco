---
import {
  LOADER_FRAME_CADENCE_MS,
  LOADER_FRAMES,
  PAGE_LOADER_EXIT_MS,
  PAGE_LOADER_MINIMUM_MS,
  PAGE_LOADER_SAFETY_MS,
} from "@/lib/loader";

interface Props {
  tone?: "light" | "dark";
}

const { tone = "light" } = Astro.props;
---

<div
  class:list={["page-loader", `page-loader--${tone}`]}
  data-page-loader
  data-frame-cadence={LOADER_FRAME_CADENCE_MS}
  data-minimum-visible={PAGE_LOADER_MINIMUM_MS}
  data-exit-duration={PAGE_LOADER_EXIT_MS}
  data-load-safety={PAGE_LOADER_SAFETY_MS}
  role="status"
  aria-live="polite"
  aria-label="Loading NNCO"
>
  <span
    class:list={[
      "nnco-loader-mark",
      { "nnco-loader-mark--on-dark": tone === "dark" },
    ]}
    data-page-loader-sequence
    aria-hidden="true"
  >
    {
      LOADER_FRAMES.map((src, index) => (
        <img
          class:list={[
            "nnco-loader-mark__frame",
            { "is-active": index === 0 },
          ]}
          src={src}
          alt=""
          width="300"
          height="300"
          loading="eager"
          fetchpriority="high"
        />
      ))
    }
  </span>
</div>

<script>
  const loader = document.querySelector<HTMLElement>("[data-page-loader]");

  if (loader && document.documentElement.classList.contains("skip-page-loader")) {
    document
      .querySelector<HTMLElement>("[data-page-content]")
      ?.removeAttribute("inert");
    loader.remove();
    window.dispatchEvent(new Event("nnco:page-ready"));
  } else if (loader) {
    const frameCadenceMs = Number(loader.dataset.frameCadence);
    const minimumVisibleMs = Number(loader.dataset.minimumVisible);
    const exitDurationMs = Number(loader.dataset.exitDuration);
    const loadSafetyMs = Number(loader.dataset.loadSafety);
    const frames = Array.from(
      loader.querySelectorAll<HTMLElement>(".nnco-loader-mark__frame"),
    );
    const motionPreference = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    );
    const startedAt = performance.now();
    let activeFrame = 0;
    let frameTimer = 0;
    let dismissed = false;
    let removalTimer = 0;
    let minimumTimer = 0;

    const restorePageInteraction = () => {
      document
        .querySelector<HTMLElement>("[data-page-content]")
        ?.removeAttribute("inert");
      document.body.classList.remove("is-page-loading");
    };

    const showFrame = (index: number) => {
      frames.forEach((frame, candidate) => {
        frame.classList.toggle("is-active", candidate === index);
      });
    };

    const syncMotionPreference = () => {
      window.clearInterval(frameTimer);
      frameTimer = 0;
      activeFrame = 0;
      showFrame(activeFrame);

      if (!motionPreference.matches && frames.length > 1) {
        frameTimer = window.setInterval(() => {
          activeFrame = (activeFrame + 1) % frames.length;
          showFrame(activeFrame);
        }, frameCadenceMs);
      }
    };

    const cleanup = () => {
      window.removeEventListener("load", dismissAfterMinimum);
      motionPreference.removeEventListener("change", syncMotionPreference);
      window.clearInterval(frameTimer);
      window.clearTimeout(safetyTimer);
      window.clearTimeout(minimumTimer);
      window.clearTimeout(removalTimer);
    };

    const finishExit = () => {
      cleanup();
      restorePageInteraction();
      loader.remove();
      window.dispatchEvent(new Event("nnco:page-ready"));
    };

    const beginExit = () => {
      if (dismissed) return;
      dismissed = true;

      try {
        sessionStorage.setItem("nnco:cover-seen", "true");
      } catch {}

      if (motionPreference.matches) {
        finishExit();
        return;
      }

      loader.classList.add("is-leaving");
      removalTimer = window.setTimeout(finishExit, exitDurationMs);
    };

    const dismissAfterMinimum = () => {
      if (dismissed || minimumTimer) return;
      const remaining = Math.max(
        0,
        minimumVisibleMs - (performance.now() - startedAt),
      );
      minimumTimer = window.setTimeout(beginExit, remaining);
    };

    if (document.readyState === "complete") {
      dismissAfterMinimum();
    } else {
      window.addEventListener("load", dismissAfterMinimum, { once: true });
    }

    const safetyTimer = window.setTimeout(dismissAfterMinimum, loadSafetyMs);
    syncMotionPreference();
    motionPreference.addEventListener("change", syncMotionPreference);

    document.addEventListener(
      "astro:before-swap",
      () => {
        cleanup();
        restorePageInteraction();
      },
      { once: true },
    );
  }
</script>
