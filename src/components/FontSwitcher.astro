---
import { fontPreferenceOptions } from "@/lib/font-preference";

interface Props {
  visible?: boolean;
}

const { visible = true } = Astro.props;
---

<div class="font-switcher" data-font-switcher hidden={!visible}>
  <label for="font-switcher-typeface">Typeface</label>
  <select id="font-switcher-typeface" data-font-select>
    {
      fontPreferenceOptions.map((option) => (
        <option value={option.value}>{option.label}</option>
      ))
    }
  </select>
</div>

<script>
  import {
    FONT_PREFERENCE_STORAGE_KEY,
    isStoredFontPreference,
    type StoredFontPreference,
  } from "@/lib/font-preference";

  const root = document.documentElement;

  function syncFontSelects(preference: StoredFontPreference | null) {
    document.querySelectorAll<HTMLSelectElement>("[data-font-select]").forEach(
      (select) => {
        select.value = preference ?? "";
      },
    );
  }

  function applyFontPreference(preference: StoredFontPreference | null) {
    if (preference === null) {
      root.removeAttribute("data-font");
    } else {
      root.dataset.font = preference;
    }
    syncFontSelects(preference);
  }

  function initialiseFontSwitchers() {
    const activePreference = root.getAttribute("data-font");
    applyFontPreference(
      isStoredFontPreference(activePreference) ? activePreference : null,
    );

    document.querySelectorAll<HTMLSelectElement>("[data-font-select]").forEach(
      (select) => {
        if (select.dataset.fontSelectReady === "true") return;
        select.dataset.fontSelectReady = "true";

        select.addEventListener("change", () => {
          const value = select.value;
          if (value !== "" && !isStoredFontPreference(value)) {
            syncFontSelects(
              isStoredFontPreference(root.dataset.font)
                ? root.dataset.font
                : null,
            );
            return;
          }

          const preference = isStoredFontPreference(value) ? value : null;
          applyFontPreference(preference);
          try {
            if (preference === null) {
              localStorage.removeItem(FONT_PREFERENCE_STORAGE_KEY);
            } else {
              localStorage.setItem(FONT_PREFERENCE_STORAGE_KEY, preference);
            }
          } catch {}
        });
      },
    );
  }

  window.addEventListener("storage", (event) => {
    if (event.key !== FONT_PREFERENCE_STORAGE_KEY) return;
    if (event.newValue === null) {
      applyFontPreference(null);
    } else if (isStoredFontPreference(event.newValue)) {
      applyFontPreference(event.newValue);
    }
  });

  initialiseFontSwitchers();
  document.addEventListener("astro:page-load", initialiseFontSwitchers);
</script>

<style>
  .font-switcher {
    position: fixed;
    z-index: 90;
    right: max(var(--gutter), env(safe-area-inset-right));
    bottom: max(1rem, env(safe-area-inset-bottom));
    display: flex;
    max-width: calc(100vw - (2 * var(--gutter)));
    gap: 0.65rem;
    align-items: center;
    padding: 0.5rem;
    border: 1px solid var(--ink);
    background: var(--paper);
    color: var(--ink);
  }

  .font-switcher[hidden] {
    display: none;
  }

  .font-switcher label {
    color: var(--ink);
    font-size: var(--type-size-small);
    font-weight: var(--type-weight-medium);
    line-height: var(--type-leading-small);
  }

  .font-switcher select {
    width: 7rem;
    min-height: 2.5rem;
    padding: 0.35rem 0.6rem;
    border: 1px solid var(--ink);
    border-radius: var(--radius-structural);
    background: var(--surface);
    color: var(--ink);
    cursor: pointer;
  }

  .font-switcher select:hover {
    background: var(--surface-strong);
  }

  .font-switcher select:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 3px;
  }

  @media (max-width: 767px) {
    .font-switcher {
      right: max(0.75rem, env(safe-area-inset-right));
      bottom: max(0.75rem, env(safe-area-inset-bottom));
      max-width: calc(100vw - 1.5rem);
    }

    .font-switcher select {
      min-height: 3rem;
    }
  }

  @media print {
    .font-switcher {
      display: none !important;
    }
  }
</style>
