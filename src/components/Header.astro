---
import BlockArrow from "./BlockArrow.astro";
import BrandLogo from "./BrandLogo.astro";
import Button from "./Button.astro";
import { siteNavigation } from "@/data/site";

interface Props {
  currentPath?: string;
  overHero?: boolean;
}

const { currentPath = Astro.url.pathname, overHero = false } = Astro.props;

---

<header
  class:list={["site-header", { "site-header--over-hero": overHero }]}
  data-site-header={overHero ? "hero" : "solid"}
>
  <div class="content-rail site-header__inner">
    <BrandLogo eager />

    <nav class="site-nav" aria-label="Primary navigation">
      {
        siteNavigation.map((item) => (
          <a
            href={item.href}
            aria-current={
              currentPath === item.href || currentPath === `${item.href}/`
                ? "page"
                : undefined
            }
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <details class="site-menu">
      <summary>Menu</summary>
      <nav class="site-menu__panel" aria-label="Mobile primary navigation">
        {
          siteNavigation.map((item) => (
            <a
              href={item.href}
              aria-current={
                currentPath === item.href || currentPath === `${item.href}/`
                  ? "page"
                  : undefined
              }
            >
              {item.label}
            </a>
          ))
        }
      </nav>
    </details>

    <Button href="/discovery" size="small">
      Start diagnostic
      <BlockArrow />
    </Button>
  </div>
</header>
