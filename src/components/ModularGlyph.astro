---
import {
  assertGlyphPattern,
  buildGlyphPath,
  hasGlyphSymmetry,
} from "@/lib/glyph-generator";
import type {
  ModularGlyphCell,
  ModularGlyphSymmetry,
} from "@/lib/modular-glyph";

interface Props {
  gridSize: number;
  cells: readonly ModularGlyphCell[];
  symmetry: ModularGlyphSymmetry;
  label?: string;
  class?: string;
}

const { gridSize, cells, symmetry, label, class: className } = Astro.props;
const cellSize = 100;
const viewBoxSize = gridSize * cellSize;

assertGlyphPattern({ gridSize, cells });
if (
  symmetry !== "none" &&
  !hasGlyphSymmetry({ gridSize, cells }, symmetry)
) {
  throw new Error(`ModularGlyph cells must follow ${symmetry} symmetry.`);
}

const path = buildGlyphPath({ gridSize, cells }, cellSize, cellSize / 2);
const isLabelled = Boolean(label);
---

<svg
  class:list={["modular-glyph", className]}
  viewBox={`0 0 ${viewBoxSize} ${viewBoxSize}`}
  role={isLabelled ? "img" : undefined}
  aria-label={label}
  aria-hidden={isLabelled ? undefined : "true"}
  focusable="false"
  shape-rendering="geometricPrecision"
>
  <path
    d={path}
    fill="currentColor"
    fill-rule="evenodd"
    clip-rule="evenodd"
  />
</svg>

<style>
  .modular-glyph {
    display: block;
    width: clamp(3.5rem, 5vw, 4.25rem);
    height: auto;
    color: currentColor;
  }
</style>
