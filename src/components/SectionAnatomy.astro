---
interface Props {
  title: string;
  titleId?: string;
  class?: string;
}

const { title, titleId, class: className } = Astro.props;
---

<div class:list={["section-anatomy", className]}>
  <span class="section-anatomy__rule" aria-hidden="true"></span>
  <h2 class="section-anatomy__title" id={titleId}>{title}</h2>
  <div class="section-anatomy__content">
    <slot />
  </div>
</div>
