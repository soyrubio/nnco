---
import SectionRow from "./SectionRow.astro";

interface Props {
  title: string;
  titleId?: string;
  contentWidth?: "50" | "75" | "100";
  class?: string;
}

const {
  title,
  titleId,
  contentWidth,
  class: className,
} = Astro.props;
---

<div
  class:list={[
    "section-anatomy",
    contentWidth && `section-anatomy--content-${contentWidth}`,
    className,
  ]}
>
  <span class="section-anatomy__rule" aria-hidden="true"></span>
  <SectionRow title={title} titleId={titleId}>
    <slot />
  </SectionRow>
</div>
