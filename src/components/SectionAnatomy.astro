---
import SectionRow from "./SectionRow.astro";

interface Props {
  title: string;
  titleId?: string;
  class?: string;
}

const { title, titleId, class: className } = Astro.props;
---

<div class:list={["section-anatomy", className]}>
  <span class="section-anatomy__rule" aria-hidden="true"></span>
  <SectionRow title={title} titleId={titleId}>
    <slot />
  </SectionRow>
</div>
