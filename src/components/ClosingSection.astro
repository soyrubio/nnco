---
import BlockArrow from "./BlockArrow.astro";
import Button from "./Button.astro";
import SectionAnatomy from "./SectionAnatomy.astro";
import SectionFrame from "./SectionFrame.astro";
import type { LinkAction } from "./types";

interface Props {
  description: string;
  actions: readonly LinkAction[];
  title?: string;
  id?: string;
  tone?: "paper" | "surface" | "dark";
}

const {
  description,
  actions,
  title = "Start here",
  id = "closing",
  tone = "dark",
} = Astro.props;
const titleId = `${id}-title`;
---

<SectionFrame
  id={id}
  tone={tone}
  labelledBy={titleId}
  class={`closing-section closing-section--${tone}`}
>
  <SectionAnatomy title={title} titleId={titleId}>
    <div class="closing-callout">
      <p>{description}</p>
      <div class="closing-callout__actions">
        {
          actions.map((action) => (
            <Button
              href={action.href}
              variant={action.variant ?? "secondary"}
              aria-label={action.ariaLabel}
            >
              {action.label}
              {(action.arrow ?? true) && <BlockArrow />}
            </Button>
          ))
        }
      </div>
    </div>
  </SectionAnatomy>
</SectionFrame>
