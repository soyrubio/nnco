---
interface Props {
  id?: string;
  tone?: "paper" | "surface" | "dark";
  width?: "full" | "reading";
  labelledBy?: string;
  class?: string;
}

const {
  id,
  tone = "paper",
  width = "full",
  labelledBy,
  class: className,
} = Astro.props;
---

<section
  id={id}
  class:list={[
    "section-frame",
    `section-frame--${tone}`,
    `section-frame--${width}`,
    className,
  ]}
  aria-labelledby={labelledBy}
>
  <div class="content-rail section-frame__inner">
    <slot />
  </div>
</section>
