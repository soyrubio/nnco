---
interface Props {
  id?: string;
  tone?: "paper" | "dark";
  labelledBy?: string;
  ariaLabel?: string;
  class?: string;
}

const {
  id,
  tone = "paper",
  labelledBy,
  ariaLabel,
  class: className,
} = Astro.props;
---

<section
  id={id}
  data-header-tone={tone === "dark" ? "dark" : undefined}
  class:list={[
    "section-frame",
    `section-frame--${tone}`,
    className,
  ]}
  aria-labelledby={labelledBy}
  aria-label={labelledBy ? undefined : ariaLabel}
>
  <div class="content-rail section-frame__inner">
    <slot />
  </div>
</section>
