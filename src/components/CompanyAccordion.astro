---
import { waysOfWorking } from "@/data/site";
---

<div class="company-accordion">
  {
    waysOfWorking.map((item, index) => (
      <details name="company-approach" open={index === 0}>
        <summary>
          <span>{item.title}</span>
          <span aria-hidden="true">+</span>
        </summary>
        <div>
          <p>{item.description}</p>
        </div>
      </details>
    ))
  }
</div>
