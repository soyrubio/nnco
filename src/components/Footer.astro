---
import BrandLogo from "./BrandLogo.astro";
import { footerGroups } from "@/data/site";
---

<footer class="site-footer">
  <div class="content-rail site-footer__inner">
    <div class="site-footer__identity">
      <BrandLogo />
      <p>AI consulting and development for large institutions.</p>
    </div>

    <nav class="site-footer__navigation" aria-label="Footer navigation">
      {
        footerGroups.map((group) => (
          <div>
            <p>{group.label}</p>
            {group.links.map((link) => (
              <a href={link.href}>{link.label}</a>
            ))}
          </div>
        ))
      }
    </nav>

    <p class="site-footer__copyright">
      © {new Date().getFullYear()} NNCO
    </p>
  </div>
</footer>
