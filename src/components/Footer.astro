---
import BrandLogo from "./BrandLogo.astro";
import { footerGroups } from "@/data/site";
import { isDiscoveryEnabled } from "@/lib/feature-flags";

interface Props {
  tone?: "paper" | "dark";
}

const { tone = "paper" } = Astro.props;
const discoveryEnabled = isDiscoveryEnabled(
  import.meta.env.DISCOVERY_ENABLED,
);
---

<footer
  class:list={["site-footer", tone === "dark" && "site-footer--dark"]}
  data-header-tone={tone === "dark" ? "dark" : undefined}
>
  <div class="content-rail site-footer__inner">
    <div class="site-footer__identity">
      <BrandLogo />
      <p>AI consulting and development for large institutions.</p>
    </div>

    <nav class="site-footer__navigation" aria-label="Footer navigation">
      {
        footerGroups.map((group) => (
          <div>
            <p>{group.label}</p>
            {group.links
              .filter((link) => discoveryEnabled || link.href !== "/discovery")
              .map((link) => (
                <a href={link.href}>{link.label}</a>
              ))}
          </div>
        ))
      }
    </nav>

    <p class="site-footer__copyright">
      © {new Date().getFullYear()} NNCo.
    </p>
  </div>
</footer>
