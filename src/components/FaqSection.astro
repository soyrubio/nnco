---
import FaqList from "./FaqList.astro";
import SectionAnatomy from "./SectionAnatomy.astro";
import SectionFrame from "./SectionFrame.astro";
import type { FaqItem } from "@/data/faq";

interface Props {
  items: readonly FaqItem[];
  title?: string;
  id?: string;
}

const {
  items,
  title = "Common questions",
  id = "faq",
} = Astro.props;
const titleId = `${id}-title`;
---

<SectionFrame id={id} labelledBy={titleId} class="faq-section">
  <SectionAnatomy title={title} titleId={titleId}>
    <FaqList items={items} groupName={`${id}-questions`} />
  </SectionAnatomy>
</SectionFrame>
