---
import Button from "./Button.astro";
import { CONTACT_CONSENT_VERSION } from "@/lib/contact-contract";
---

<contact-form class="contact-form-shell" data-consent-version={CONTACT_CONSENT_VERSION}>
  <form class="contact-form" data-contact-form novalidate>
    <div class="contact-form__grid">
      <label class="field">
        <span>Name</span>
        <input name="name" autocomplete="name" required minlength="2" />
        <small data-error-for="name"></small>
      </label>

      <label class="field">
        <span>Work email</span>
        <input name="email" type="email" autocomplete="email" inputmode="email" required />
        <small data-error-for="email"></small>
      </label>

      <label class="field">
        <span>Organisation</span>
        <input name="institution" autocomplete="organization" required minlength="2" />
        <small data-error-for="institution"></small>
      </label>

      <label class="field">
        <span>Sector</span>
        <select name="sector" required>
          <option value="">Select sector</option>
          <option>Banking</option>
          <option>Insurance</option>
          <option>Healthcare</option>
          <option>Capital markets or asset management</option>
          <option>Other</option>
        </select>
        <small data-error-for="sector"></small>
      </label>

      <label class="field">
        <span>What is this about?</span>
        <select name="area" required>
          <option value="">Select one</option>
          <option>An AI audit</option>
          <option>A specific workflow</option>
          <option>Private or on-premise infrastructure</option>
          <option>Running a system we already have</option>
          <option>Something else</option>
        </select>
        <small data-error-for="area"></small>
      </label>

      <label class="field contact-form__message">
        <span>What are you working on?</span>
        <textarea
          name="message"
          rows="6"
          minlength="10"
          maxlength="4000"
          placeholder="The workflow, where it slows down, and any constraint you already know about."
          required
        ></textarea>
        <small data-error-for="message"></small>
      </label>

      <label class="contact-form__consent">
        <input name="consent" type="checkbox" required />
        <span>I agree that NNCO may use these details to respond to my enquiry. <a href="/privacy">Privacy</a></span>
        <small data-error-for="consent"></small>
      </label>
    </div>

    <div class="contact-form__footer">
      <div class="contact-form__submit">
        <Button type="submit">Send</Button>
        <p>We reply within one business day.</p>
      </div>
      <p data-form-status role="status" aria-live="polite"></p>
    </div>
  </form>
</contact-form>

<script>
  class NncoContactForm extends HTMLElement {
    connectedCallback() {
      const form = this.querySelector<HTMLFormElement>("[data-contact-form]");
      const status = this.querySelector<HTMLElement>("[data-form-status]");
      const submit = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
      const consentVersion = this.dataset.consentVersion;
      let requestId = crypto.randomUUID();

      if (!form || !status || !submit || !consentVersion) return;

      const clearErrors = () => {
        form.querySelectorAll<HTMLElement>("[data-error-for]").forEach((item) => {
          item.textContent = "";
        });
        form.querySelectorAll<HTMLElement>("[aria-invalid]").forEach((field) =>
          field.removeAttribute("aria-invalid"),
        );
      };

      const showError = (field: HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement) => {
        field.setAttribute("aria-invalid", "true");
        const target = form.querySelector<HTMLElement>(`[data-error-for="${field.name}"]`);
        if (!target) return;
        target.textContent =
          field.name === "consent"
            ? "We need this to be able to reply."
            : field.validity.typeMismatch
              ? "Enter a valid work email address."
              : field.validity.tooShort && field.name === "message"
                ? "Add a sentence or two so we can come prepared."
                : "This field is required.";
      };

      form.addEventListener("submit", async (event) => {
        event.preventDefault();
        clearErrors();
        status.className = "";
        status.textContent = "";

        const invalidFields = Array.from(
          form.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>(":invalid"),
        );
        if (invalidFields.length > 0) {
          invalidFields.forEach(showError);
          invalidFields[0].focus();
          status.className = "is-error";
          status.textContent = "Check the highlighted fields.";
          return;
        }

        const data = new FormData(form);
        const payload = {
          schemaVersion: 1,
          requestId,
          name: String(data.get("name") ?? ""),
          workEmail: String(data.get("email") ?? ""),
          organisation: String(data.get("institution") ?? ""),
          sector: String(data.get("sector") ?? ""),
          area: String(data.get("area") ?? ""),
          message: String(data.get("message") ?? ""),
          consent: { accepted: true, version: consentVersion },
        };

        submit.disabled = true;
        submit.textContent = "Sending.";
        status.className = "is-loading";
        status.textContent = "Sending.";

        try {
          const response = await fetch("/api/contact-requests", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload),
          });
          const result = await response.json().catch(() => null);
          if (!response.ok || result?.ok !== true) throw new Error("handoff failed");

          form.reset();
          requestId = crypto.randomUUID();
          status.className = "is-success";
          status.textContent = "Received. We will reply within one business day.";
        } catch {
          status.className = "is-error";
          status.textContent =
            "That did not send. Email us at general@nnco.ai and we will pick it up from there.";
        } finally {
          submit.disabled = false;
          submit.textContent = "Send";
        }
      });
    }
  }

  if (!customElements.get("contact-form")) {
    customElements.define("contact-form", NncoContactForm);
  }
</script>
