---
import BlockArrow from "./BlockArrow.astro";
import Button from "./Button.astro";
import type { LinkAction } from "./types";
import { isDiscoveryEnabled } from "@/lib/feature-flags";

interface Props {
  title: string;
  introduction?: string;
  actions?: readonly LinkAction[];
  actionsLabel?: string;
  titleId?: string;
  class?: string;
}

const {
  title,
  introduction,
  actions = [],
  actionsLabel,
  titleId = "page-title",
  class: className,
} = Astro.props;

const discoveryEnabled = isDiscoveryEnabled(
  import.meta.env.DISCOVERY_ENABLED,
);
const visibleActions = actions.filter(
  (action) => discoveryEnabled || action.href !== "/discovery",
);
const ActionsContainer = actionsLabel ? "nav" : "div";
---

<header
  class:list={["editorial-hero", className]}
  aria-labelledby={titleId}
>
  <div class="content-rail editorial-hero__inner" data-viewport-motion>
    <h1 id={titleId} data-viewport-motion-item>{title}</h1>
    {
      introduction && (
        <p
          class="editorial-hero__introduction"
          data-viewport-motion-item
          style="--viewport-motion-delay: 140ms"
        >
          {introduction}
        </p>
      )
    }
    {
      visibleActions.length > 0 && (
        <ActionsContainer
          class="editorial-actions"
          aria-label={actionsLabel}
        >
          {visibleActions.map((action) => (
            <Button
              href={action.href}
              variant={action.variant ?? "primary"}
              aria-label={action.ariaLabel}
            >
              {action.label}
              {(action.arrow ?? true) && <BlockArrow />}
            </Button>
          ))}
        </ActionsContainer>
      )
    }
  </div>
</header>
