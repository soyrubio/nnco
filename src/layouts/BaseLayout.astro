---
import PageLoader from "@/components/PageLoader.astro";
import Schema from "@/components/Schema.astro";
import "@fontsource-variable/geist";
import "@/styles/global.css";

interface PreloadImage {
  href: string;
  media?: string;
  type?: string;
}

interface Props {
  title?: string;
  description?: string;
  image?: string;
  themeColor?: string;
  preloadImages?: PreloadImage[];
  canonicalPath?: string;
  schemas?: Record<string, unknown>[];
  noindex?: boolean;
}

const {
  title = "AI consulting and development for large institutions | NNCO",
  description = "NNCO designs, integrates and operates AI systems for large institutions, from the initial AI audit through production operation.",
  image = "/assets/nnco-hero-mosaic-hifi.png",
  themeColor = "#f5f5f5",
  preloadImages = [],
  canonicalPath = Astro.url.pathname,
  schemas = [],
  noindex = false,
} = Astro.props;

const siteOrigin = "https://nnco.ai";
const canonicalUrl = new URL(canonicalPath, siteOrigin).toString();
const imageUrl = new URL(image, siteOrigin).toString();
const organisationSchema = {
  "@type": "Organization",
  "@id": `${siteOrigin}/#organization`,
  name: "NNCO",
  url: siteOrigin,
  logo: `${siteOrigin}/assets/nnco-logo.svg`,
  description:
    "NNCO is an AI consulting and development company. It designs, integrates and operates AI systems for large institutions, from an initial AI audit to running the system in production.",
  email: "general@nnco.ai",
  address: {
    "@type": "PostalAddress",
    addressLocality: "Prague",
    addressCountry: "CZ",
  },
  areaServed: "EU",
  knowsAbout: [
    "AI implementation",
    "on-premise AI deployment",
    "AI governance",
    "KYC automation",
    "claims processing automation",
    "EU AI Act",
  ],
};
const graph = [organisationSchema, ...schemas];
const loaderTone =
  themeColor.trim().toLowerCase() === "#111111" ? "dark" : "light";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content={themeColor} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="NNCO" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {
      preloadImages.map(({ href, media, type }) => (
        <link
          rel="preload"
          as="image"
          href={href}
          media={media}
          type={type}
          fetchpriority="high"
        />
      ))
    }
    <Schema graph={graph} />
    <title>{title}</title>
    <script is:inline>
      try {
        if (sessionStorage.getItem("nnco:cover-seen") === "true") {
          document.documentElement.classList.add("skip-page-loader");
        }
      } catch {}
    </script>
    <noscript>
      <style>
        .page-loader {
          display: none !important;
        }
      </style>
    </noscript>
  </head>
  <body>
    <PageLoader tone={loaderTone} />
    <div data-page-content>
      <slot />
    </div>
    <script is:inline>
      if (!document.documentElement.classList.contains("skip-page-loader")) {
        document
          .querySelector("[data-page-content]")
          ?.setAttribute("inert", "");
      }
    </script>
  </body>
</html>
