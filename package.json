    "@types/react-dom": "^19.2.3",
    "astro": "7.2.0",
    "motion": "13.1.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/markdown-satteri": "0.3.5",
    "@types/node": "^22.19.19",
    "parse5": "7.3.0",
    "typescript": "^5.9.3",
    "wrangler": "4.122.0"
  }
