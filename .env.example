# Public application origin
PUBLIC_APP_URL=http://localhost:4321

# Optional future AI adapters
OPENAI_API_KEY=
OPENAI_DISCOVERY_MODEL=
OPENAI_SOLUTION_MODEL=

# Local handoff mode uses process-ephemeral storage in development only.
LEAD_HANDOFF_MODE=local

# Durable production handoff. These values are server-only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
