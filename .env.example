# Local development defaults. Copy this file to .env; never commit .env.
# pnpm dev selects the local Cloudflare profile and NODE_ENV=development.
PUBLIC_APP_URL=http://localhost:4321
LEAD_HANDOFF_MODE=local
DISCOVERY_RATE_LIMIT_MODE=local
DISCOVERY_ENABLED=false

# Required for website research, report generation and voice transcription.
# Without a key the questionnaire still works, but AI requests fail closed.
OPENAI_API_KEY=
OPENAI_DISCOVERY_MODEL=gpt-5.6-luna
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
OPENAI_API_BASE_URL=https://api.openai.com

# Local development supplies safe fallbacks. Production requires independent
# random values of at least 32 characters, stored as Cloudflare secrets.
DISCOVERY_CONTEXT_SIGNING_SECRET=
DISCOVERY_RATE_LIMIT_SECRET=

# Production-only Supabase settings. Leave blank locally; store them directly
# on the production Cloudflare Worker. Never use the publishable key here.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
