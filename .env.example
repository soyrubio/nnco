# Public application origin
PUBLIC_APP_URL=http://localhost:4321

# Server-only AI adapters. Discovery requires the API key in production.
OPENAI_API_KEY=
OPENAI_DISCOVERY_MODEL=gpt-5.6-luna
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
OPENAI_API_BASE_URL=https://api.openai.com
DISCOVERY_CONTEXT_SIGNING_SECRET=
DISCOVERY_RATE_LIMIT_SECRET=

# Local handoff mode uses process-ephemeral storage in development only.
LEAD_HANDOFF_MODE=local

# Durable production handoff. These values are server-only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DISCOVERY_RATE_LIMIT_MODE=supabase
